# Cine-Stream Media Explorer Environment Variables
# Copy this file to .env and provide your API keys

# TMDB (The Movie Database) - Primary API
# Generate a free v3 API key at: https://www.themoviedb.org/settings/api
VITE_TMDB_API_KEY=

# Optional: OMDB (Open Movie Database) - Fallback for ISP Blocked Regions
# Generate free key at: http://www.omdbapi.com/apikey.aspx
VITE_OMDB_API_KEY=

# Optional: Google Gemini API - Powering the AI "Mood Matcher"
# Generate free API key at: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=

# TMDB Configuration Overrides (defaults preconfigured in client)
VITE_TMDB_BASE_URL=https://api.themoviedb.org/3
VITE_TMDB_IMAGE_BASE=https://image.tmdb.org/t/p
